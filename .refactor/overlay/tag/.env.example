# Local taxonomy editing also works without Immich/DB credentials.
# Set these values to enable image previews and calibration.
IMMICH_URL=http://immich-server:2283
IMMICH_EXTERNAL_URL=https://photos.example.com
IMMICH_API_PREFIX=/api
IMMICH_API_KEY=
IMMICH_MACHINE_LEARNING_URL=http://immich-machine-learning:3003
IMMICH_NETWORK=immich_default
TAG_MANAGER_PORT=3031
TAG_TAXONOMY_VOLUME=immich-tag-manager-data
# Read-only access to public.asset and public.smart_search only
IMMICH_DB_HOST=
IMMICH_DB_PORT=5432
IMMICH_DB_USER=immich_tag_manager
IMMICH_DB_PASSWORD=
IMMICH_DB_NAME=immich
IMMICH_DB_SSL=false
# Alternative: IMMICH_DB_URL=postgresql://...
# Local development defaults; Compose sets the /app paths explicitly.
# TAG_TAXONOMY_PATH=./storage/tags.json
# TAG_TAXONOMY_DEFAULT_PATH=./data/tags.json
